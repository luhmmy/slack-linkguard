# Example environment variables for LinkGuard
# Copy this file to .env and fill in your actual values

# Slack Bot Credentials
# Get these from https://api.slack.com/apps → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# VirusTotal API Key
# Get this from https://www.virustotal.com/gui/my-apikey
VT_API_KEY=your-virustotal-api-key-here
