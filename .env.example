# Example environment variables for LinkGuard
# Copy this file to .env and fill in your actual values

# Slack OAuth Credentials (for multi-workspace distribution)
# Get these from https://api.slack.com/apps → Your App → Basic Information
SLACK_CLIENT_ID=your-client-id-here
SLACK_CLIENT_SECRET=your-client-secret-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# VirusTotal API Key
# Get this from https://www.virustotal.com/gui/my-apikey
VT_API_KEY=your-virustotal-api-key-here

# Google Safe Browsing API Key (fallback when VirusTotal is unavailable)
# Get this from https://console.cloud.google.com/ → Enable Safe Browsing API → Create Credentials
GOOGLE_SAFE_BROWSING_API_KEY=your-google-safe-browsing-api-key-here

# Optional: Port (defaults to 5000)
PORT=5000
